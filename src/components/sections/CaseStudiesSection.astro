---
import CaseStudyTabs from "../react/CaseStudyTabs.tsx";
---

<section class="case-studies-section pt-10 pb-10">
  <div class="mx-auto w-full max-w-[1440px] px-4 md:px-8 lg:px-12">
    <!-- Line -->
    <div class="h-px w-full bg-white/10"></div>

    <div class="pt-10 md:pt-16"></div>

    <!-- Header: grid 1fr 1fr 0.5fr -->
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
      <h2 class="case-studies-heading text-white">Casi<br />Studio.</h2>
      <div class="flex max-w-[22rem] flex-col gap-4 md:text-right md:items-end">
        <span class="text-[0.6875rem] font-medium uppercase tracking-[0.1em] text-white/40">
          i risultati parlano più delle parole
        </span>
        <p class="text-sm leading-[160%] text-white/40">
          Ogni progetto parla di una storia di crescita.<br />
          Scopri i nostri casi studio.
        </p>
      </div>
    </div>

    <div class="pt-8 md:pt-12"></div>

    <!-- Tabs + Slider -->
    <CaseStudyTabs client:visible />
  </div>

  <div class="pt-10 md:pt-16"></div>

  <!-- Bottom line -->
  <div class="mx-auto w-full max-w-[1440px] px-4 md:px-8 lg:px-12">
    <div class="h-px w-full bg-white/10"></div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("astro:page-load", () => {
    if (!document.querySelector(".case-studies-section")) return;

    gsap.from(".case-studies-heading", {
      y: 20,
      opacity: 0,
      duration: 0.8,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".case-studies-section",
        start: "top 75%",
        toggleActions: "play none none reverse",
      },
    });
  });
</script>
