const columns = [col1, col2, col3];
---

<section class="reviews-section pt-10 pb-10">
  <div class="mx-auto w-full max-w-[1000px] px-4 md:px-8 lg:px-12">
    <!-- Line -->
    <div class="h-px w-full bg-black/10"></div>

    <div class="pt-10 md:pt-16"></div>

    <!-- Layout: heading sticky left + reviews right -->
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[0.35fr_1fr]">
      <!-- Left: sticky heading -->
      <div class="lg:sticky lg:top-32 lg:self-start">
        <div class="mb-4 flex items-center gap-3">
          <div class="h-px w-8 bg-black/30"></div>
          <span class="text-[0.6875rem] font-medium uppercase tracking-[0.1em] text-black/40">Clienti soddisfatti</span>
        </div>
        <h3 class="reviews-heading">Oltre 30 aziende hanno già scelto Vincenzo Petrone Biz con successo</h3>
      </div>

      <!-- Right: 3 column infinite vertical carousel -->
      <div class="reviews-container relative">
        <!-- Top fade -->
        <div class="pointer-events-none absolute left-0 right-0 top-0 z-10 h-20 bg-gradient-to-b from-white to-transparent"></div>
        <!-- Bottom fade -->
        <div class="pointer-events-none absolute bottom-0 left-0 right-0 z-10 h-20 bg-gradient-to-t from-white to-transparent"></div>

        <div class="grid grid-cols-1 gap-5 overflow-hidden md:grid-cols-3" style="max-height: 80vh;">
          {columns.map((col, colIdx) => (
            <div class={`review-column review-column-${colIdx}`}>
              <div class="review-track flex flex-col gap-5">
                {/* Original cards */}
                {col.map((review) => (
                  <div class="review-card rounded-2xl border border-black/10 bg-black/10 p-6 backdrop-blur-sm transition-transform duration-300 hover:-translate-y-1">
                    <div class="mb-3 text-[1.2rem] text-[#ffd700]">★★★★★</div>
                    <p class="mb-4 text-[0.95rem] italic leading-[1.6] text-black">"{review.text}"</p>
                    <div class="flex items-center gap-3">
                      <div class="h-10 w-10 flex-shrink-0 overflow-hidden rounded-full border-2 border-black/20">
                        <img src={review.avatar} alt={review.author} class="h-full w-full object-cover" loading="lazy" />
                      </div>
                      <div>
                        <span class="block text-sm font-semibold text-black">{review.author}</span>
                        <span class="block text-xs text-black/50">{review.role}</span>
                      </div>
                    </div>
                  </div>
                ))}
                {/* Duplicates for seamless loop */}
                {col.map((review) => (
                  <div class="review-card rounded-2xl border border-black/10 bg-black/10 p-6 backdrop-blur-sm transition-transform duration-300 hover:-translate-y-1" aria-hidden="true">
                    <div class="mb-3 text-[1.2rem] text-[#ffd700]">★★★★★</div>
                    <p class="mb-4 text-[0.95rem] italic leading-[1.6] text-black">"{review.text}"</p>
                    <div class="flex items-center gap-3">
                      <div class="h-10 w-10 flex-shrink-0 overflow-hidden rounded-full border-2 border-black/20">
                        <img src={review.avatar} alt={review.author} class="h-full w-full object-cover" loading="lazy" />
                      </div>
                      <div>
                        <span class="block text-sm font-semibold text-black">{review.author}</span>
                        <span class="block text-xs text-black/50">{review.role}</span>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .review-track {
    animation: scroll-vertical 40s linear infinite;
  }

  .review-column-1 .review-track {
    animation-direction: reverse;
    animation-duration: 35s;
  }

  .review-column-2 .review-track {
    animation-duration: 45s;
  }

  @keyframes scroll-vertical {
    0% { transform: translateY(0); }
    100% { transform: translateY(-50%); }
  }

  .review-track:hover {
    animation-play-state: paused;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("astro:page-load", () => {
    if (!document.querySelector(".reviews-section")) return;

    gsap.from(".reviews-heading", {
      y: 20,
      opacity: 0,
      duration: 0.8,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".reviews-section",
        start: "top 75%",
        toggleActions: "play none none reverse",
      },
    });
  });
</script>
