---
import FaqAccordion from "../react/FaqAccordion.tsx";
---

<section class="faq-section relative pt-10 pb-10">
  <div class="mx-auto w-full max-w-[1000px] px-4 md:px-8 lg:px-12">
    <!-- Gradient line separator -->
    <div class="h-px w-full" style="background: linear-gradient(90deg, #1B4088, #A51B80 50%, #DA5713);"></div>

    <div class="pt-10 md:pt-16"></div>

    <!-- 2 columns: sticky left + accordion right -->
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[0.4fr_1fr] lg:gap-16">
      <!-- Left: sticky heading + WhatsApp -->
      <div class="lg:sticky lg:top-32 lg:self-start">
        <div class="mb-4 flex items-center gap-3">
          <div class="h-px w-8" style="background: linear-gradient(90deg, #1B4088, #A51B80);"></div>
          <span class="text-[0.6875rem] font-medium uppercase tracking-[0.1em] text-black/40">FAQ</span>
        </div>

        <h2 class="faq-heading text-black">Domande frequenti</h2>

        <p class="mt-4 text-sm leading-[160%] text-black/40 md:text-base">
          Hai una domanda? Dai un'occhiata qui sotto!
        </p>

        <!-- WhatsApp CTA -->
        <a
          href="https://wa.me/393319942136?text=Ciao%2C%20ho%20una%20domanda%20per%20voi!"
          target="_blank"
          rel="noopener noreferrer"
          class="group mt-6 inline-flex items-center gap-3 rounded-full border border-[#25D366]/30 bg-[#25D366]/10 px-6 py-3 overflow-hidden transition-all duration-500 hover:bg-[#25D366] hover:border-[#25D366]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" class="flex-shrink-0 fill-[#25D366] transition-[fill] duration-500 group-hover:fill-white">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span class="relative block overflow-hidden text-sm font-semibold">
            <span class="flex items-center gap-2 text-[#25D366] transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-translate-y-full group-hover:text-black">
              Scrivici su WhatsApp
            </span>
            <span class="absolute inset-0 flex items-center gap-2 translate-y-full text-black transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-y-0">
              Scrivici su WhatsApp
            </span>
          </span>
        </a>
      </div>

      <!-- Right: tabs + accordion -->
      <div>
        <FaqAccordion client:visible />
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("astro:page-load", () => {
    if (!document.querySelector(".faq-section")) return;

    gsap.from(".faq-heading", {
      y: 20,
      opacity: 0,
      duration: 0.8,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".faq-section",
        start: "top 75%",
        toggleActions: "play none none reverse",
      },
    });
  });
</script>
