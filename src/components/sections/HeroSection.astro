---
import ExpandButton from "../react/ExpandButton.tsx";
import ContactCard from "../react/ContactCard.tsx";
import LogoMarquee from "./LogoMarquee.astro";

const services = [
  "Siti web professionali",
  "Marketing Digitale",
  "Branding & Design",
  "Web App & Gestionali",
];

const rotatingWords = [
  "convertire visite in clienti.",
  "aumentare le vendite.",
  "rafforzare l'identità aziendale.",
];
---

<section class="relative flex min-h-screen flex-col overflow-clip">
  <!-- Spacer top (per navbar) -->
  <div class="h-20 md:h-24"></div>

  <!-- Heading + Buttons -->
  <div class="mx-auto w-full max-w-[1440px] px-4 md:px-8 lg:px-12">
    <div class="flex flex-wrap items-end justify-between">
      <h1
        class="hero-heading z-[5] text-[clamp(2.5rem,7vw,4.1rem)] font-semibold leading-[90%] tracking-[-0.05em] text-[#faf4f4]"
      >
        Trasformiamo le tue idee in siti che vendono davvero
      </h1>
    </div>

    <div class="mt-6 mb-6 flex flex-wrap items-center gap-5">
      <ExpandButton text="Sei nuovo? Parti da qui" variant="gradient" client:load />
      <a
        href="/portfolio"
        class="btn-gradient group relative inline-block rounded-full text-center font-medium shadow-[0_16px_20px_rgba(0,0,0,0.4)] transition-all duration-300 hover:shadow-[0_20px_40px_rgba(165,27,128,0.3)] active:shadow-[0_4px_4px_rgba(0,0,0,0.3)]"
      >
        <div class="relative z-10 overflow-hidden rounded-full px-6 py-3 transition-shadow duration-300 shadow-[inset_0_0_7px_rgba(255,255,255,0.28)] group-hover:shadow-[inset_0_0_14px_rgba(255,255,255,0.5)]">
          <div class="pointer-events-none absolute inset-0 z-[1] rounded-full">
            <div class="expand-ball expand-ball-1"></div>
            <div class="expand-ball expand-ball-2"></div>
          </div>
          <span class="relative z-[5] block overflow-hidden text-[1.125rem] font-semibold tracking-[-0.03em] text-white">
            <span class="flex items-center gap-2 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-translate-y-full">
              Scopri i nostri casi studio
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </span>
            <span class="absolute inset-0 flex items-center justify-center gap-2 translate-y-full transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-y-0">
              Scopri i nostri casi studio
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </span>
          </span>
        </div>
        <div class="btn-glow pointer-events-none absolute inset-0 z-0 rounded-full blur-md transition-opacity duration-300 opacity-30 group-hover:opacity-50">
          <div class="expand-ball expand-ball-1"></div>
          <div class="expand-ball expand-ball-2"></div>
        </div>
      </a>
      <a href="/portfolio" class="rounded-full border border-white/20 px-6 py-3 text-[1.125rem] font-semibold tracking-[-0.03em] text-white transition-colors duration-200 hover:bg-white/10">
        Casi studio →
      </a>
    </div>
  </div>

  <!-- Main content area: Unicorn animation + services + bottom -->
  <div class="mx-auto flex w-full max-w-[1440px] flex-1 px-3 pb-3">
    <div
      class="relative flex w-full flex-1 flex-col justify-between gap-11 overflow-clip rounded-[2rem] p-[1.125rem] md:p-8"
    >
      <!-- Unicore Studio WebGL Animation (full background) -->
      <div
        data-us-project="bY70DXpatqmZLyp9qTQs"
        class="absolute inset-0 z-[1] flex items-stretch justify-center"
        style="width:100%;height:100%;padding-bottom:0;padding-right:0;"
      ></div>

      <!-- Services grid -->
      <div class="relative z-[3] grid w-full grid-cols-2 gap-4 md:grid-cols-4">
        {services.map((service) => (
          <div class="flex flex-col items-center gap-4">
            <span class="text-center text-sm font-semibold text-gray-100 md:text-base">
              {service}
            </span>
            <div class="h-px w-full border-b border-dotted border-white/50"></div>
          </div>
        ))}
      </div>

      <!-- Bottom area: subheading + contact CTA -->
      <div class="relative z-[2] flex w-full flex-col items-start justify-between gap-8 mb-2.5 md:flex-row md:items-end">
        <!-- Subheading con parole rotanti -->
        <div class="relative z-[5] flex max-w-[43rem] flex-col items-start text-white">
          <div class="text-[0.6875rem] font-medium uppercase tracking-[0.1em] text-white/40">
            SIAMO BIZSTUDIO<sup class="text-[0.6em]">®</sup>
          </div>
          <div class="mt-2"></div>
          <h3 class="text-xl font-semibold leading-[115%] tracking-[-0.05em] md:text-2xl lg:text-[2rem]">
            Non creiamo semplici siti web. Creiamo macchine da business che lavorano 24/7 per
          </h3>
          <div class="relative w-full overflow-clip">
            <div class="words-rotator flex flex-col">
              {rotatingWords.map((word, i) => (
                <div
                  class:list={[
                    "flex items-center gap-2",
                    i === 0 ? "relative" : "absolute",
                    i === 1 ? "top-full" : "",
                    i === 2 ? "top-[200%]" : "",
                  ]}
                >
                  <span class="text-xl font-semibold leading-[115%] tracking-[-0.05em] md:text-2xl lg:text-[2rem]">
                    {word}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Contact CTA card (React island, expandable on hover) -->
        <ContactCard client:visible />
      </div>
    </div>
  </div>
</section>

<!-- Logo marquee (sotto il box hero) -->
<div class="mx-auto w-full max-w-[1440px] px-3">
  <LogoMarquee />
</div>

<!-- Unicorn Studio WebGL -->
<script is:inline>
!function(){if(!window.UnicornStudio){window.UnicornStudio={isInitialized:!1};var i=document.createElement("script");i.src="https://cdn.jsdelivr.net/gh/hiunicornstudio/unicornstudio.js@v1.4.30/dist/unicornStudio.umd.js",i.onload=function(){window.UnicornStudio.isInitialized||(UnicornStudio.init(),window.UnicornStudio.isInitialized=!0)},(document.head || document.body).appendChild(i)}}();
</script>

<script>
  import { gsap } from "gsap";

  let wordInterval: ReturnType<typeof setInterval>;

  document.addEventListener("astro:before-swap", () => {
    if (wordInterval) clearInterval(wordInterval);
  });

  document.addEventListener("astro:page-load", () => {
    const wordsContainer = document.querySelector(".words-rotator");
    if (!wordsContainer) return;

    // Word rotator animation
    const words = wordsContainer.children;
    let currentIndex = 0;
    const totalWords = words.length;

    gsap.set(wordsContainer, { height: (words[0] as HTMLElement).clientHeight });

    wordInterval = setInterval(() => {
      const nextIndex = (currentIndex + 1) % totalWords;

      gsap.to(wordsContainer, {
        y: `-${nextIndex * 100}%`,
        duration: 0.6,
        ease: "power2.inOut",
      });

      currentIndex = nextIndex;
    }, 3000);

    // Hero heading entrance animation
    gsap.from(".hero-heading", {
      y: 40,
      opacity: 0,
      duration: 1,
      ease: "power3.out",
      delay: 0.3,
    });
  });
</script>
