---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Demo Transizioni — Vincenzo Petrone Biz">
  <!-- Pannello controlli fisso -->
  <div id="transition-panel" class="fixed top-20 right-4 z-[200] flex flex-col gap-1.5 rounded-2xl border border-black/10 bg-black/90 p-3 backdrop-blur-xl max-w-[210px]">
    <span class="text-[0.6rem] font-bold uppercase tracking-[0.15em] text-black/40 mb-0.5">Scegli transizione</span>

    <button data-transition="directional-blur" class="trans-btn group rounded-xl border border-black/10 bg-black/5 px-3 py-2 text-left text-sm font-semibold text-black transition-all duration-300 hover:border-white/25 hover:bg-black/10">
      <span class="block text-black text-[0.8rem]">1. Directional Blur</span>
      <span class="block text-[0.6rem] text-black/40">Onda blur dal click</span>
    </button>

    <button data-transition="ethereal-blur" class="trans-btn group rounded-xl border border-black/10 bg-black/5 px-3 py-2 text-left text-sm font-semibold text-black transition-all duration-300 hover:border-white/25 hover:bg-black/10">
      <span class="block text-black text-[0.8rem]">2. Ethereal Blur</span>
      <span class="block text-[0.6rem] text-black/40">Blur uniforme + fade</span>
    </button>

    <button data-transition="brand-curtain" class="trans-btn group rounded-xl border border-black/10 bg-black/5 px-3 py-2 text-left text-sm font-semibold text-black transition-all duration-300 hover:border-white/25 hover:bg-black/10">
      <span class="block text-black text-[0.8rem]">3. Brand Curtain</span>
      <span class="block text-[0.6rem] text-black/40">Sipario gradiente</span>
    </button>

    <button data-transition="portal-zoom" class="trans-btn group rounded-xl border border-black/10 bg-black/5 px-3 py-2 text-left text-sm font-semibold text-black transition-all duration-300 hover:border-white/25 hover:bg-black/10">
      <span class="block text-black text-[0.8rem]">4. Portal Zoom</span>
      <span class="block text-[0.6rem] text-black/40">Elemento si espande</span>
    </button>

    <button data-transition="stagger-wave" class="trans-btn group rounded-xl border border-black/10 bg-black/5 px-3 py-2 text-left text-sm font-semibold text-black transition-all duration-300 hover:border-white/25 hover:bg-black/10">
      <span class="block text-black text-[0.8rem]">5. Stagger Wave</span>
      <span class="block text-[0.6rem] text-black/40">Uscita coreografica</span>
    </button>

    <button data-transition="morph-clip" class="trans-btn group rounded-xl border border-black/10 bg-black/5 px-3 py-2 text-left text-sm font-semibold text-black transition-all duration-300 hover:border-white/25 hover:bg-black/10">
      <span class="block text-black text-[0.8rem]">6. Morph Clip</span>
      <span class="block text-[0.6rem] text-black/40">Cerchio dal click</span>
    </button>

    <button data-transition="silk-slide" class="trans-btn group rounded-xl border border-black/10 bg-black/5 px-3 py-2 text-left text-sm font-semibold text-black transition-all duration-300 hover:border-white/25 hover:bg-black/10">
      <span class="block text-black text-[0.8rem]">7. Silk Slide</span>
      <span class="block text-[0.6rem] text-black/40">Slide + motion blur</span>
    </button>

    <button data-transition="dissolve-noise" class="trans-btn group rounded-xl border border-black/10 bg-black/5 px-3 py-2 text-left text-sm font-semibold text-black transition-all duration-300 hover:border-white/25 hover:bg-black/10">
      <span class="block text-black text-[0.8rem]">8. Dissolve Noise</span>
      <span class="block text-[0.6rem] text-black/40">Dissoluzione magica</span>
    </button>

    <div class="mt-1 pt-1.5 border-t border-black/10">
      <span class="block text-[0.6rem] text-black/30 text-center leading-tight">Seleziona e poi clicca<br/>gli hotspot nella pagina</span>
    </div>
  </div>

  <!-- Contenuto demo -->
  <main id="demo-content" class="pt-28 pb-20">
    <div class="mx-auto w-full max-w-[1000px] px-4 md:px-8 lg:px-12">

      <div class="demo-section mb-6 flex items-center gap-3">
        <div class="h-px w-8 bg-black/30"></div>
        <span class="text-[0.6875rem] font-medium uppercase tracking-[0.1em] text-black/40">demo transitions</span>
        <div class="h-px w-8 bg-black/30"></div>
      </div>

      <h1 class="demo-section mb-4 text-black">Prova le 8 Transizioni</h1>

      <p class="demo-section text-sm text-black/40 md:text-base max-w-xl mb-8">
        <strong class="text-black/60">1)</strong> Seleziona una transizione dal pannello.
        <strong class="text-black/60">2)</strong> Clicca su uno degli hotspot colorati sparsi nella pagina per vederla in azione dal punto di click.
      </p>

      <!-- Hotspot in alto a sinistra -->
      <div class="demo-section mb-8 flex flex-wrap gap-4">
        <button class="hotspot cursor-pointer rounded-2xl border-2 border-dashed border-blue-500/30 bg-blue-500/5 px-8 py-6 text-center transition-all duration-300 hover:border-blue-500/60 hover:bg-blue-500/10">
          <span class="block text-lg font-bold text-blue-400">Hotspot</span>
          <span class="block text-xs text-blue-400/50 mt-1">Alto sinistra</span>
        </button>
        <button class="hotspot cursor-pointer rounded-2xl border-2 border-dashed border-purple-500/30 bg-purple-500/5 px-8 py-6 text-center transition-all duration-300 hover:border-purple-500/60 hover:bg-purple-500/10">
          <span class="block text-lg font-bold text-purple-400">Hotspot</span>
          <span class="block text-xs text-purple-400/50 mt-1">Alto centro</span>
        </button>
        <div class="flex-1"></div>
        <button class="hotspot cursor-pointer rounded-2xl border-2 border-dashed border-pink-500/30 bg-pink-500/5 px-8 py-6 text-center transition-all duration-300 hover:border-pink-500/60 hover:bg-pink-500/10 mr-[240px]">
          <span class="block text-lg font-bold text-pink-400">Hotspot</span>
          <span class="block text-xs text-pink-400/50 mt-1">Alto destra</span>
        </button>
      </div>

      <!-- Grid cards demo -->
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        <div class="demo-section overflow-hidden rounded-2xl border border-black/10 bg-black/5 p-6">
          <div class="h-40 rounded-xl bg-gradient-to-br from-blue-600/20 to-purple-600/20 mb-4"></div>
          <h3 class="text-lg font-semibold text-black mb-2">Misha Travel</h3>
          <p class="text-sm text-black/40">Tour operator con dashboard personalizzata</p>
        </div>
        <div class="demo-section overflow-hidden rounded-2xl border border-black/10 bg-black/5 p-6">
          <div class="h-40 rounded-xl bg-gradient-to-br from-purple-600/20 to-pink-600/20 mb-4"></div>
          <h3 class="text-lg font-semibold text-black mb-2">Collezione Burlamacco</h3>
          <p class="text-sm text-black/40">E-commerce ufficiale Carnevale di Viareggio</p>
        </div>
        <div class="demo-section overflow-hidden rounded-2xl border border-black/10 bg-black/5 p-6">
          <div class="h-40 rounded-xl bg-gradient-to-br from-pink-600/20 to-orange-600/20 mb-4"></div>
          <h3 class="text-lg font-semibold text-black mb-2">Vi.cla Future</h3>
          <p class="text-sm text-black/40">Segnaletica ferroviaria e impianti elettrici</p>
        </div>

        <!-- Hotspot grande al centro della grid -->
        <div class="demo-section flex items-center justify-center">
          <button class="hotspot cursor-pointer w-full h-full min-h-[200px] rounded-2xl border-2 border-dashed border-orange-500/30 bg-orange-500/5 px-6 py-8 text-center transition-all duration-300 hover:border-orange-500/60 hover:bg-orange-500/10">
            <span class="block text-2xl font-bold text-orange-400">Hotspot</span>
            <span class="block text-sm text-orange-400/50 mt-2">Centro pagina</span>
          </button>
        </div>

        <div class="demo-section overflow-hidden rounded-2xl border border-black/10 bg-black/5 p-6">
          <div class="h-40 rounded-xl bg-gradient-to-br from-cyan-600/20 to-blue-600/20 mb-4"></div>
          <h3 class="text-lg font-semibold text-black mb-2">Kenekita</h3>
          <p class="text-sm text-black/40">Property management in Sardegna</p>
        </div>
        <div class="demo-section overflow-hidden rounded-2xl border border-black/10 bg-black/5 p-6">
          <div class="h-40 rounded-xl bg-gradient-to-br from-emerald-600/20 to-cyan-600/20 mb-4"></div>
          <h3 class="text-lg font-semibold text-black mb-2">LogPlus</h3>
          <p class="text-sm text-black/40">Piattaforma logistica aziendale</p>
        </div>
      </div>

      <!-- Hotspot in basso -->
      <div class="demo-section mt-8 flex flex-wrap gap-4 justify-between">
        <button class="hotspot cursor-pointer rounded-2xl border-2 border-dashed border-emerald-500/30 bg-emerald-500/5 px-12 py-8 text-center transition-all duration-300 hover:border-emerald-500/60 hover:bg-emerald-500/10">
          <span class="block text-xl font-bold text-emerald-400">Hotspot</span>
          <span class="block text-xs text-emerald-400/50 mt-1">Basso sinistra</span>
        </button>
        <button class="hotspot cursor-pointer rounded-2xl border-2 border-dashed border-yellow-500/30 bg-yellow-500/5 px-12 py-8 text-center transition-all duration-300 hover:border-yellow-500/60 hover:bg-yellow-500/10 mr-[240px]">
          <span class="block text-xl font-bold text-yellow-400">Hotspot</span>
          <span class="block text-xs text-yellow-400/50 mt-1">Basso destra</span>
        </button>
      </div>

    </div>
  </main>

  <!-- Overlay per Directional Blur: blur fisso, solo clip-path animato -->
  <div id="blur-wave" class="pointer-events-none fixed inset-0 z-[148] blur-wave-overlay"></div>

  <!-- Overlay per Brand Curtain -->
  <div id="curtain-overlay" class="pointer-events-none fixed inset-0 z-[150] translate-y-full" style="background: linear-gradient(135deg, #1B4088, #A51B80 50%, #DA5713); opacity: 0;"></div>

  <!-- Overlay per Morph Clip -->
  <div id="clip-overlay" class="pointer-events-none fixed inset-0 z-[150] bg-black" style="clip-path: circle(0% at 50% 50%); opacity: 0;"></div>

  <!-- SVG noise filter per dissolve -->
  <svg class="hidden">
    <defs>
      <filter id="noise-filter">
        <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch" result="noise"/>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G"/>
      </filter>
    </defs>
  </svg>

  <style>
    .blur-wave-overlay {
      backdrop-filter: blur(28px) brightness(0.4);
      -webkit-backdrop-filter: blur(28px) brightness(0.4);
      background: rgba(0, 0, 0, 0.15);
      clip-path: circle(0px at 50% 50%);
    }
  </style>

  <!-- Label transizione attiva -->
  <div id="transition-label" class="pointer-events-none fixed bottom-6 left-1/2 z-[200] -translate-x-1/2 rounded-full border border-black/10 bg-black/80 px-5 py-2 text-sm font-semibold text-black opacity-0 backdrop-blur-xl">
    <span id="label-text"></span>
  </div>

  <!-- Indicatore transizione selezionata -->
  <div id="selected-indicator" class="pointer-events-none fixed bottom-16 left-1/2 z-[200] -translate-x-1/2 rounded-full border border-black/5 bg-black/5 px-4 py-1.5 text-xs text-black/30 backdrop-blur-xl opacity-0">
    Selezionata: <span id="selected-name" class="text-black/60 font-semibold">—</span>
  </div>
</Layout>

<script>
  import { gsap } from "gsap";

  const content = document.getElementById("demo-content")!;
  const sections = gsap.utils.toArray<HTMLElement>(".demo-section");
  const curtain = document.getElementById("curtain-overlay")!;
  const clipOverlay = document.getElementById("clip-overlay")!;
  const blurWave = document.getElementById("blur-wave")!;
  const label = document.getElementById("transition-label")!;
  const labelText = document.getElementById("label-text")!;
  const selectedIndicator = document.getElementById("selected-indicator")!;
  const selectedName = document.getElementById("selected-name")!;

  let isAnimating = false;
  let currentTransition = "directional-blur"; // default

  // ═══════════════════════════════════════
  // HELPERS
  // ═══════════════════════════════════════
  function showLabel(text: string) {
    labelText.textContent = text;
    gsap.killTweensOf(label);
    gsap.fromTo(label, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.3 });
    gsap.to(label, { opacity: 0, y: -10, duration: 0.3, delay: 2 });
  }

  function setActive(btn: HTMLElement) {
    document.querySelectorAll(".trans-btn").forEach(b => {
      (b as HTMLElement).style.borderColor = "";
      (b as HTMLElement).style.backgroundColor = "";
    });
    btn.style.borderColor = "rgba(255,255,255,0.35)";
    btn.style.backgroundColor = "rgba(255,255,255,0.12)";
  }

  function resetAll() {
    gsap.set(content, { clearProps: "all" });
    gsap.set(sections, { clearProps: "all" });
    gsap.set(curtain, { y: "100%", opacity: 0 });
    gsap.set(clipOverlay, { opacity: 0, clipPath: "circle(0% at 50% 50%)" });
    blurWave.style.clipPath = "circle(0px at 50% 50%)";
    content.style.filter = "none";
  }

  // ═══════════════════════════════════════
  // 1. DIRECTIONAL BLUR — onda blur dal click
  // ═══════════════════════════════════════
  function directionalBlur(x: number, y: number) {
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const maxDist = Math.hypot(Math.max(x, vw - x), Math.max(y, vh - y));
    const endPx = Math.ceil(maxDist) + 100;

    // Proxy object per animare il raggio del cerchio via GSAP
    // (GSAP non interpola bene clip-path direttamente in tutti i browser)
    const wave = { r: 0 };
    const shrink = { r: endPx };

    const tl = gsap.timeline({ onComplete: () => { isAnimating = false; } });

    // EXIT: onda blur si espande dal punto click
    tl.set(blurWave, { clipPath: `circle(0px at ${x}px ${y}px)` })
      .to(wave, {
        r: endPx,
        duration: 0.55,
        ease: "power2.out",
        onUpdate: () => {
          blurWave.style.clipPath = `circle(${wave.r}px at ${x}px ${y}px)`;
        },
      })
      // Contenuto svanisce mentre il blur lo copre
      .to(content, {
        opacity: 0,
        duration: 0.3,
        ease: "power1.in",
      }, 0.2)
      // Piccola pausa — tutto blurrato
      .to({}, { duration: 0.08 })
      // ENTER: prepara contenuto fresco
      .call(() => {
        gsap.set(content, { opacity: 1 });
        gsap.set(sections, { y: 20, opacity: 0 });
      })
      // Blur si ritira verso il centro
      .to(shrink, {
        r: 0,
        duration: 0.5,
        ease: "power2.inOut",
        onUpdate: () => {
          blurWave.style.clipPath = `circle(${shrink.r}px at ${vw / 2}px ${vh / 2}px)`;
        },
      })
      // Sezioni entrano con stagger
      .to(sections, {
        y: 0,
        opacity: 1,
        duration: 0.4,
        ease: "power2.out",
        stagger: 0.03,
      }, "-=0.45")
      // Cleanup
      .set(blurWave, { clipPath: "circle(0px at 50% 50%)" });

    return tl;
  }

  // ═══════════════════════════════════════
  // 2. ETHEREAL BLUR — blur uniforme + fade
  // ═══════════════════════════════════════
  function etherealBlur() {
    const tl = gsap.timeline({ onComplete: () => { isAnimating = false; } });

    tl.to(content, {
      filter: "blur(20px)",
      opacity: 0,
      duration: 0.55,
      ease: "power2.inOut",
    })
    .set(content, { filter: "blur(25px)", opacity: 0 })
    .set(sections, { y: 15, opacity: 0 })
    .to(content, {
      filter: "blur(0px)",
      opacity: 1,
      duration: 0.5,
      ease: "power2.out",
    })
    .to(sections, {
      y: 0,
      opacity: 1,
      duration: 0.4,
      ease: "power2.out",
      stagger: 0.025,
    }, "-=0.4");

    return tl;
  }

  // ═══════════════════════════════════════
  // 3. BRAND CURTAIN
  // ═══════════════════════════════════════
  function brandCurtain() {
    const tl = gsap.timeline({ onComplete: () => { isAnimating = false; } });

    tl.set(curtain, { y: "-100%", opacity: 1 })
      .to(curtain, { y: "0%", duration: 0.45, ease: "power3.inOut" })
      .set(content, { opacity: 0 }, 0.3)
      .to({}, { duration: 0.1 })
      .to(curtain, { y: "100%", duration: 0.45, ease: "power3.inOut" })
      .set(content, { opacity: 1 }, "-=0.35")
      .from(sections, { y: 30, opacity: 0, duration: 0.4, ease: "power2.out", stagger: 0.03 }, "-=0.3")
      .set(curtain, { y: "100%", opacity: 0 });

    return tl;
  }

  // ═══════════════════════════════════════
  // 4. PORTAL ZOOM — elemento si espande dal click
  // ═══════════════════════════════════════
  function portalZoom(x: number, y: number) {
    const vw = window.innerWidth;
    const vh = window.innerHeight;

    const portal = document.createElement("div");
    portal.style.cssText = `
      position: fixed; z-index: 155; border-radius: 50%;
      background: linear-gradient(135deg, #1B4088, #A51B80 50%, #DA5713);
      left: ${x}px; top: ${y}px; width: 0; height: 0;
      pointer-events: none; transform: translate(-50%, -50%);
    `;
    document.body.appendChild(portal);

    const maxDist = Math.max(
      Math.hypot(x, y), Math.hypot(vw - x, y),
      Math.hypot(x, vh - y), Math.hypot(vw - x, vh - y)
    );
    const size = maxDist * 2.2;

    const tl = gsap.timeline({
      onComplete: () => { portal.remove(); isAnimating = false; }
    });

    tl.to(portal, { width: size, height: size, duration: 0.55, ease: "power3.inOut" })
      .set(content, { opacity: 0 }, 0.3)
      .to(portal, { opacity: 0, scale: 1.3, duration: 0.35, ease: "power2.in" })
      .set(content, { opacity: 1 })
      .from(sections, { y: 20, opacity: 0, duration: 0.35, ease: "power2.out", stagger: 0.025 }, "-=0.2");

    return tl;
  }

  // ═══════════════════════════════════════
  // 5. STAGGER WAVE
  // ═══════════════════════════════════════
  function staggerWave() {
    const tl = gsap.timeline({ onComplete: () => { isAnimating = false; } });

    tl.to(sections, { y: -40, opacity: 0, duration: 0.35, ease: "power2.in", stagger: 0.04 })
      .to({}, { duration: 0.08 })
      .set(sections, { y: 40, opacity: 0 })
      .to(sections, { y: 0, opacity: 1, duration: 0.4, ease: "power2.out", stagger: 0.035 });

    return tl;
  }

  // ═══════════════════════════════════════
  // 6. MORPH CLIP — cerchio dal click
  // ═══════════════════════════════════════
  function morphClip(x: number, y: number) {
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const maxDist = Math.hypot(Math.max(x, vw - x), Math.max(y, vh - y));
    const endPx = Math.ceil(maxDist) + 50;

    const tl = gsap.timeline({ onComplete: () => { isAnimating = false; } });

    tl.set(clipOverlay, { clipPath: `circle(0px at ${x}px ${y}px)`, opacity: 1 })
      .to(clipOverlay, { clipPath: `circle(${endPx}px at ${x}px ${y}px)`, duration: 0.55, ease: "power4.inOut" })
      .set(content, { opacity: 0 }, 0.3)
      .to(clipOverlay, { clipPath: `circle(0px at ${vw / 2}px ${vh / 2}px)`, duration: 0.45, ease: "power3.inOut" })
      .set(content, { opacity: 1 }, "-=0.35")
      .from(sections, { scale: 0.97, opacity: 0, duration: 0.4, ease: "power2.out", stagger: 0.02 }, "-=0.3")
      .set(clipOverlay, { opacity: 0 });

    return tl;
  }

  // ═══════════════════════════════════════
  // 7. SILK SLIDE
  // ═══════════════════════════════════════
  function silkSlide() {
    const tl = gsap.timeline({ onComplete: () => { isAnimating = false; } });

    tl.to(content, { x: "-8%", filter: "blur(12px)", opacity: 0, duration: 0.45, ease: "power3.in" })
      .set(content, { x: "8%", filter: "blur(12px)", opacity: 0 })
      .to(content, { x: "0%", filter: "blur(0px)", opacity: 1, duration: 0.5, ease: "power3.out" });

    return tl;
  }

  // ═══════════════════════════════════════
  // 8. DISSOLVE NOISE
  // ═══════════════════════════════════════
  function dissolveNoise() {
    const svgFilter = document.querySelector("#noise-filter feDisplacementMap") as SVGFEDisplacementMapElement;

    const tl = gsap.timeline({
      onComplete: () => { content.style.filter = "none"; isAnimating = false; }
    });

    tl.to(content, {
      opacity: 0, duration: 0.5, ease: "power2.in",
      onStart: () => { content.style.filter = "url(#noise-filter)"; },
      onUpdate: function() { svgFilter?.setAttribute("scale", String(this.progress() * 80)); },
    })
    .to({}, { duration: 0.1 })
    .to(content, {
      opacity: 1, duration: 0.55, ease: "power2.out",
      onUpdate: function() { svgFilter?.setAttribute("scale", String((1 - this.progress()) * 60)); },
      onComplete: () => { content.style.filter = "none"; svgFilter?.setAttribute("scale", "0"); },
    });

    return tl;
  }

  // ═══════════════════════════════════════
  // TRANSITION REGISTRY
  // ═══════════════════════════════════════
  type TransEntry = { fn: (x: number, y: number) => gsap.core.Timeline; label: string; directional: boolean };

  const transitions: Record<string, TransEntry> = {
    "directional-blur": { fn: (x, y) => directionalBlur(x, y),  label: "Directional Blur",  directional: true },
    "ethereal-blur":    { fn: () => etherealBlur(),              label: "Ethereal Blur",      directional: false },
    "brand-curtain":    { fn: () => brandCurtain(),              label: "Brand Curtain",      directional: false },
    "portal-zoom":      { fn: (x, y) => portalZoom(x, y),       label: "Portal Zoom",        directional: true },
    "stagger-wave":     { fn: () => staggerWave(),               label: "Stagger Wave",       directional: false },
    "morph-clip":       { fn: (x, y) => morphClip(x, y),        label: "Morph Clip",         directional: true },
    "silk-slide":       { fn: () => silkSlide(),                 label: "Silk Slide",         directional: false },
    "dissolve-noise":   { fn: () => dissolveNoise(),             label: "Dissolve Noise",     directional: false },
  };

  // ═══════════════════════════════════════
  // PLAY TRANSITION (shared logic)
  // ═══════════════════════════════════════
  function playTransition(x: number, y: number) {
    if (isAnimating) return;
    isAnimating = true;

    const entry = transitions[currentTransition];
    if (!entry) return;

    resetAll();
    showLabel(entry.label);
    entry.fn(x, y);
  }

  // ═══════════════════════════════════════
  // PANEL: seleziona transizione
  // ═══════════════════════════════════════
  document.querySelectorAll(".trans-btn").forEach(btn => {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const type = (btn as HTMLElement).dataset.transition!;
      currentTransition = type;
      setActive(btn as HTMLElement);

      const entry = transitions[type];
      selectedName.textContent = entry.label;
      gsap.killTweensOf(selectedIndicator);
      gsap.to(selectedIndicator, { opacity: 1, duration: 0.2 });
      gsap.to(selectedIndicator, { opacity: 0, duration: 0.3, delay: 2 });

      // Anteprima veloce: lancia subito dal punto click
      const me = e as MouseEvent;
      playTransition(me.clientX, me.clientY);
    });
  });

  // ═══════════════════════════════════════
  // HOTSPOT: clicca ovunque nella pagina
  // ═══════════════════════════════════════
  document.querySelectorAll(".hotspot").forEach(hs => {
    hs.addEventListener("click", (e) => {
      e.stopPropagation();
      const me = e as MouseEvent;
      playTransition(me.clientX, me.clientY);
    });
  });

  // Seleziona il primo di default
  const firstBtn = document.querySelector('.trans-btn[data-transition="directional-blur"]') as HTMLElement;
  if (firstBtn) setActive(firstBtn);
</script>
