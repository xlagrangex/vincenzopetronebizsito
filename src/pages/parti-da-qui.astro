</LayoutMinimal>

<script>
  import { gsap } from "gsap";
  let autoAdvanceTimer: ReturnType<typeof setTimeout> | null = null;
  let typeTimeout: ReturnType<typeof setTimeout> | null = null;

  document.addEventListener("astro:before-swap", () => {
    if (autoAdvanceTimer) clearTimeout(autoAdvanceTimer);
    if (typeTimeout) clearTimeout(typeTimeout);
    gsap.killTweensOf("*");
  });

  document.addEventListener("astro:page-load", () => {
    if (!document.querySelector(".form-page")) return;

    let currentStep = 1;
    let isAnimating = false;
    let userName = "";
    const formData: Record<string, string> = {};

    // DOM
    const btnBack = document.querySelector(".btn-back") as HTMLElement;
    const btnNext = document.querySelector(".btn-next") as HTMLElement;
    const btnText = document.querySelector(".btn-text") as HTMLElement;
    const btnTextClone = document.querySelector(".btn-text-clone span") as HTMLElement;
    const btnArrow = document.querySelector(".btn-arrow") as HTMLElement;
    const btnSpinner = document.querySelector(".btn-spinner") as HTMLElement;
    const formNav = document.querySelector(".form-nav") as HTMLElement;
    const progressFill = document.querySelector(".progress-fill") as HTMLElement;
    const stepNumDisplay = document.querySelector(".step-num-display") as HTMLElement;
    const stepMotivation = document.querySelector(".step-motivation") as HTMLElement;
    const formProgress = document.querySelector(".form-progress") as HTMLElement;
    const topBar = document.querySelector(".top-bar") as HTMLElement;

    // Entrance
    gsap.fromTo(".top-bar", { y: -20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: "power3.out", delay: 0.1 });
    // Progress bar hidden on step 1, entrance animations for step 1 content
    gsap.fromTo('[data-step="1"]', { y: 15, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: "power3.out", delay: 0.45 });
    gsap.fromTo(".form-nav", { y: 10, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, ease: "power3.out", delay: 0.55 });
    gsap.fromTo(".social-proof", { y: 10, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: "power3.out", delay: 0.7 });

    // Focus name input
    setTimeout(() => { (document.getElementById("nome-input") as HTMLInputElement)?.focus(); }, 800);

    // ─── Button enabled/disabled state ───
    function disableBtn() {
      (btnNext as HTMLButtonElement).disabled = true;
      btnNext.style.opacity = "0.35";
      btnNext.style.pointerEvents = "none";
    }
    function enableBtn() {
      (btnNext as HTMLButtonElement).disabled = false;
      btnNext.style.opacity = "1";
      btnNext.style.pointerEvents = "auto";
    }

    function checkStepValid(): boolean {
      if (currentStep === 1) {
        return !!(document.getElementById("nome-input") as HTMLInputElement)?.value.trim();
      }
      if (currentStep === 2) {
        const cardSelected = !!document.querySelector('[data-step="2"] .option-card.selected');
        const chipSelected = !!document.querySelector('.chip-active');
        return cardSelected && chipSelected;
      }
      if (currentStep === 3) {
        return true; // azienda fields are optional
      }
      if (currentStep === 4) {
        return true; // budget is optional
      }
      if (currentStep === 5) {
        const cognome = (document.getElementById("cognome-input") as HTMLInputElement)?.value.trim();
        const email = (document.getElementById("email-input") as HTMLInputElement)?.value.trim();
        const telefono = (document.getElementById("telefono-input") as HTMLInputElement)?.value.trim();
        const privacy = (document.getElementById("privacy-check") as HTMLInputElement)?.checked;
        return !!(cognome && email && email.includes("@") && telefono && privacy);
      }
      return true;
    }

    function updateBtnState() {
      if (checkStepValid()) enableBtn(); else disableBtn();
    }

    // Start disabled
    disableBtn();

    // Listen for input changes to enable/disable
    document.getElementById("nome-input")?.addEventListener("input", updateBtnState);
    document.getElementById("cognome-input")?.addEventListener("input", updateBtnState);
    document.getElementById("email-input")?.addEventListener("input", updateBtnState);
    document.getElementById("telefono-input")?.addEventListener("input", updateBtnState);
    document.getElementById("privacy-check")?.addEventListener("change", updateBtnState);
    document.getElementById("budget-input")?.addEventListener("input", updateBtnState);
    document.getElementById("azienda-input")?.addEventListener("input", updateBtnState);
    document.getElementById("settore-input")?.addEventListener("input", updateBtnState);

    // Portfolio drawer
    document.querySelectorAll(".open-portfolio-bottom").forEach((btn) => {
      btn.addEventListener("click", () => {
        if ((window as any).__openPortfolioDrawer) (window as any).__openPortfolioDrawer();
        else window.dispatchEvent(new CustomEvent("portfolio-drawer-open"));
      });
    });

    // Update all .user-name spans
    function updateUserName() {
      document.querySelectorAll(".user-name").forEach((el) => { el.textContent = userName; });
    }

    // Navigate
    function goToStep(step: number | "greeting" | "success", dir: "forward" | "backward" = "forward") {
      if (isAnimating || step === currentStep) return;
      isAnimating = true;
      const curEl = document.querySelector(`[data-step="${currentStep}"]`) as HTMLElement;
      const nxtEl = document.querySelector(`[data-step="${step}"]`) as HTMLElement;
      if (!curEl || !nxtEl) { isAnimating = false; return; }

      const xO = dir === "forward" ? -30 : 30;
      const xI = dir === "forward" ? 30 : -30;

      gsap.to(curEl, { opacity: 0, x: xO, duration: 0.2, ease: "power2.in", onComplete: () => {
        curEl.style.display = "none"; curEl.style.transform = ""; curEl.style.opacity = "";
        nxtEl.style.display = "block";
        gsap.fromTo(nxtEl, { opacity: 0, x: xI }, { opacity: 1, x: 0, duration: 0.3, ease: "power3.out" });

        // Stagger cards
        const cards = nxtEl.querySelectorAll(".option-card");
        if (cards.length) gsap.fromTo(cards, { opacity: 0, y: 12, scale: 0.97 }, { opacity: 1, y: 0, scale: 1, duration: 0.35, stagger: 0.05, ease: "power3.out", delay: 0.05 });

        isAnimating = false;
      }});

      // Update progress for numeric steps
      if (typeof step === "number") {
        const pct = step * 20;
        progressFill.style.width = `${pct}%`;
        stepNumDisplay.textContent = String(step);

        const motivations: Record<number, string> = { 1: "", 2: "", 3: "Bene!", 4: "Ci siamo quasi!", 5: "Ultimo step!" };
        gsap.to(stepMotivation, { opacity: 0, duration: 0.1, onComplete: () => {
          stepMotivation.textContent = motivations[step] || "";
          gsap.to(stepMotivation, { opacity: 1, duration: 0.2 });
        }});

        btnBack.style.visibility = step <= 1 ? "hidden" : "visible";
        if (step === 5) { setBtnText("Invia la richiesta"); }
        else { setBtnText("Continua"); }
        currentStep = step;
        setTimeout(updateBtnState, 50);
      }

      // Show progress bar from step 2 onwards, hide on step 1
      if (typeof step === "number" && step >= 2 && formProgress.style.display === "none") {
        formProgress.style.display = "";
        gsap.fromTo(formProgress, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.3, ease: "power3.out" });
      }
      if (step === 1 && formProgress.style.display !== "none") {
        formProgress.style.display = "none";
      }

      // Success
      if (step === "success") {
        gsap.to(formNav, { opacity: 0, duration: 0.3, onComplete: () => { formNav.style.display = "none"; } });
        gsap.to(".form-progress", { opacity: 0, duration: 0.3 });
        gsap.to(topBar, { y: -60, opacity: 0, duration: 0.4, ease: "power3.inOut" });
        gsap.to(".social-proof", { opacity: 0, duration: 0.3 });
        // Fill email
        const emailEl = document.querySelector(".user-email");
        if (emailEl) emailEl.textContent = formData.email || "";
        setTimeout(() => {
          gsap.fromTo(".success-icon", { scale: 0, rotation: -180 }, { scale: 1, rotation: 0, duration: 0.6, ease: "elastic.out(1, 0.5)" });
          gsap.fromTo(".success-title", { y: 15, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, ease: "power3.out", delay: 0.15 });
          gsap.fromTo(".success-desc", { y: 10, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, ease: "power3.out", delay: 0.25 });
        }, 300);
      }

      // Greeting is transient
      if (step === "greeting") {
        document.querySelector(".greeting-name")!.textContent = userName;
        currentStep = "greeting" as any;
      }
    }

    function setBtnText(text: string) {
      if (btnText) btnText.textContent = text;
      if (btnTextClone) btnTextClone.textContent = text;
    }

    // Step 2: option card click
    document.querySelectorAll('[data-step="2"] .option-card').forEach((card) => {
      card.addEventListener("click", () => {
        if (isAnimating) return;
        const stepEl = card.closest(".step-content") as HTMLElement;
        stepEl.querySelectorAll(".option-card").forEach((c) => { c.classList.remove("selected"); c.setAttribute("aria-checked", "false"); });
        card.classList.add("selected"); card.setAttribute("aria-checked", "true");
        gsap.fromTo(card, { scale: 0.97 }, { scale: 1, duration: 0.4, ease: "elastic.out(1, 0.5)" });
        formData.tipo = (card as HTMLElement).dataset.value || "";
        updateBtnState();

        // Show follow-up
        const followup = stepEl.querySelector(".followup") as HTMLElement;
        if (followup && followup.style.display === "none") {
          followup.style.display = "block";
          gsap.fromTo(followup, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.4, ease: "power3.out" });
        }
      });
    });

    // Step 2: chip selection
    document.querySelectorAll(".chip").forEach((chip) => {
      chip.addEventListener("click", () => {
        document.querySelectorAll(".chip").forEach((c) => c.classList.remove("chip-active"));
        chip.classList.add("chip-active");
        formData.sitoAttuale = (chip as HTMLElement).dataset.sito || "";
        updateBtnState();

        // Show link field if has a site
        const linkField = document.querySelector(".link-field") as HTMLElement;
        if (formData.sitoAttuale !== "zero" && linkField) {
          if (linkField.style.display === "none") {
            linkField.style.display = "block";
            gsap.fromTo(linkField, { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.3, ease: "power3.out" });
          }
        } else if (linkField) {
          linkField.style.display = "none";
        }

      });
    });

    // Step 3: maturity card click
    document.querySelectorAll('[data-step="3"] .option-card').forEach((card) => {
      card.addEventListener("click", () => {
        if (isAnimating) return;
        const stepEl = card.closest(".step-content") as HTMLElement;
        stepEl.querySelectorAll(".option-card").forEach((c) => { c.classList.remove("selected"); c.setAttribute("aria-checked", "false"); });
        card.classList.add("selected"); card.setAttribute("aria-checked", "true");
        gsap.fromTo(card, { scale: 0.97 }, { scale: 1, duration: 0.4, ease: "elastic.out(1, 0.5)" });
        updateBtnState();
      });
    });

    // Keyboard on radiogroups
    document.querySelectorAll('[role="radiogroup"]').forEach((g) => {
      g.addEventListener("keydown", (e: Event) => {
        const ev = e as KeyboardEvent; const cards = Array.from(g.querySelectorAll(".option-card")); const idx = cards.indexOf(document.activeElement as Element); if (idx === -1) return; let next = -1;
        if (ev.key === "ArrowDown" || ev.key === "ArrowRight") { next = (idx + 1) % cards.length; ev.preventDefault(); }
        else if (ev.key === "ArrowUp" || ev.key === "ArrowLeft") { next = (idx - 1 + cards.length) % cards.length; ev.preventDefault(); }
        else if (ev.key === "Enter" || ev.key === " ") { (document.activeElement as HTMLElement).click(); ev.preventDefault(); return; }
        if (next >= 0) { cards.forEach((c, i) => (c as HTMLElement).tabIndex = i === next ? 0 : -1); (cards[next] as HTMLElement).focus(); }
      });
    });

    // Rotating placeholder for budget (typing effect)
    const budgetPlaceholders = ["circa 2.000€", "tra 1.000 e 5.000€", "onestamente, non ne ho idea", "circa 3.000€", "devo ancora capire"];
    let phIdx = 0;

    // Easing: slow at start, faster in middle, slow at end
    function typeDelay(charIdx: number, total: number): number {
      const t = total > 1 ? charIdx / (total - 1) : 0; // 0 to 1
      // Sine ease-in-out: slow → fast → slow
      const ease = 0.5 - Math.cos(Math.PI * t) / 2;
      return 50 + (1 - ease) * 100; // 50ms at fastest, 150ms at slowest
    }

    function typeText(input: HTMLInputElement, text: string, charIdx: number) {
      if (input.value) return;
      if (charIdx <= text.length) {
        input.placeholder = text.substring(0, charIdx);
        const delay = typeDelay(charIdx, text.length);
        typeTimeout = setTimeout(() => typeText(input, text, charIdx + 1), delay);
      } else {
        typeTimeout = setTimeout(() => eraseText(input, text.length), 2500);
      }
    }

    function eraseText(input: HTMLInputElement, charIdx: number) {
      if (input.value) return;
      if (charIdx >= 0) {
        input.placeholder = budgetPlaceholders[phIdx].substring(0, charIdx);
        typeTimeout = setTimeout(() => eraseText(input, charIdx - 1), 55);
      } else {
        phIdx = (phIdx + 1) % budgetPlaceholders.length;
        typeTimeout = setTimeout(() => {
          if (!input.value) typeText(input, budgetPlaceholders[phIdx], 0);
        }, 400);
      }
    }

    function startBudgetPlaceholder() {
      const input = document.getElementById("budget-input") as HTMLInputElement;
      if (!input) return;
      typeText(input, budgetPlaceholders[0], 0);
    }

    // Budget toggle
    const budgetToggle = document.querySelector(".budget-toggle");
    const budgetContent = document.querySelector(".budget-toggle-content") as HTMLElement;
    const budgetArrow = document.querySelector(".budget-toggle-arrow") as HTMLElement;
    if (budgetToggle && budgetContent) {
      budgetToggle.addEventListener("click", () => {
        const isOpen = budgetContent.style.maxHeight && budgetContent.style.maxHeight !== "0px" && budgetContent.style.maxHeight !== "0";
        if (isOpen) {
          budgetContent.style.maxHeight = "0px";
          budgetContent.style.opacity = "0";
          budgetArrow?.classList.remove("rotate-180");
        } else {
          budgetContent.style.maxHeight = budgetContent.scrollHeight + "px";
          budgetContent.style.opacity = "1";
          budgetArrow?.classList.add("rotate-180");
        }
      });
    }

    // Enter key on inputs
    document.getElementById("nome-input")?.addEventListener("keydown", (e) => { if ((e as KeyboardEvent).key === "Enter") btnNext.click(); });
    document.getElementById("budget-input")?.addEventListener("keydown", (e) => { if ((e as KeyboardEvent).key === "Enter") btnNext.click(); });
    document.getElementById("email-input")?.addEventListener("keydown", (e) => { if ((e as KeyboardEvent).key === "Enter") btnNext.click(); });

    // Back button
    btnBack.addEventListener("click", () => { if (currentStep > 1 && !isAnimating) goToStep(currentStep - 1, "backward"); });

    // Next button
    btnNext.addEventListener("click", () => {
      if (isAnimating) return;

      if (currentStep === 1) {
        // Validate name
        const nameInput = document.getElementById("nome-input") as HTMLInputElement;
        const name = nameInput.value.trim();
        if (!name) { shake(nameInput); return; }
        userName = name;
        formData.nome = name;
        updateUserName();

        // Show greeting — cinematic sequence
        goToStep("greeting" as any, "forward");

        // Hide nav + progress + social during greeting
        gsap.to(formNav, { opacity: 0, duration: 0.3 });
        gsap.to(".form-progress", { opacity: 0, duration: 0.3 });
        gsap.to(".social-proof", { opacity: 0, duration: 0.3 });

        // Fill greeting names
        document.querySelectorAll(".greeting-name").forEach((el) => { el.textContent = userName; });

        // Cinematic sequence — simple fade + slide up
        const greetTl = gsap.timeline();
        let t = 0.3;

        // Slide 1
        greetTl.fromTo(".greeting-slide-1", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.7, ease: "power3.out" }, t);
        t += 0.7 + 1.5;
        greetTl.to(".greeting-slide-1", { opacity: 0, duration: 0.4, ease: "power2.in" }, t);
        t += 0.5;

        // Slide 2: "Noi siamo Vincenzo Petrone Biz..." then "...e se hai un sogno..."
        greetTl.fromTo(".greeting-slide-2", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.7, ease: "power3.out" }, t);
        t += 0.7 + 1.2;
        greetTl.fromTo(".greeting-2b", { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.6, ease: "power3.out" }, t);
        t += 0.6 + 2.2;
        greetTl.to(".greeting-slide-2", { opacity: 0, duration: 0.4, ease: "power2.in" }, t);
        t += 0.5;

        // Slide 3
        greetTl.fromTo(".greeting-slide-3", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.7, ease: "power3.out" }, t);
        t += 0.7 + 1.0;
        greetTl.to(".greeting-slide-3", { opacity: 0, duration: 0.4, ease: "power2.in" }, t);
        t += 0.5;

        // Slide 4
        greetTl.fromTo(".greeting-slide-4", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.7, ease: "power3.out" }, t);
        t += 0.7 + 1.2;

        // Slide 4: elegant transition — scale up + blur out → step 2
        greetTl.to(".greeting-finale", { scale: 1.08, filter: "blur(12px)", opacity: 0, duration: 0.7, ease: "power2.in" }, t);
        greetTl.call(() => {
          goToStep(2, "forward");
          setTimeout(() => {
            const step2Cards = document.querySelectorAll('[data-step="2"] .option-card');
            if (step2Cards.length) {
              gsap.fromTo(step2Cards, { opacity: 0, y: 20, scale: 0.94 }, { opacity: 1, y: 0, scale: 1, duration: 0.5, stagger: 0.07, ease: "back.out(1.2)" });
            }
            gsap.to(formNav, { opacity: 1, duration: 0.4 });
            gsap.to(".form-progress", { opacity: 1, duration: 0.4 });
            gsap.to(".social-proof", { opacity: 1, duration: 0.4 });
          }, 150);
        }, [], t + 0.4);

        return;
      }

      if (currentStep === 2) {
        const sel = document.querySelector('[data-step="2"] .option-card.selected');
        if (!sel) { gsap.to('[data-step="2"] .options-grid', { x: -5, duration: 0.05, yoyo: true, repeat: 5, ease: "power2.inOut" }); return; }
        const followup = document.querySelector('[data-step="2"] .followup') as HTMLElement;
        const chipSel = followup?.querySelector(".chip-active");
        if (!chipSel) {
          const chipsWrap = followup?.querySelector(".flex.flex-wrap") as HTMLElement;
          if (chipsWrap) gsap.to(chipsWrap, { x: -5, duration: 0.05, yoyo: true, repeat: 5, ease: "power2.inOut" });
          return;
        }
        const linkInput = document.getElementById("sito-attuale") as HTMLInputElement;
        if (linkInput?.value) formData.sitoLink = linkInput.value.trim();
        if (autoAdvanceTimer) clearTimeout(autoAdvanceTimer);
        goToStep(3, "forward");
        return;
      }

      if (currentStep === 3) {
        // Store azienda data
        formData.azienda = (document.getElementById("azienda-input") as HTMLInputElement)?.value.trim() || "";
        formData.settore = (document.getElementById("settore-input") as HTMLInputElement)?.value.trim() || "";
        // Check maturità selection
        const matSel = document.querySelector('[data-step="3"] .option-card.selected');
        if (matSel) formData.maturita = (matSel as HTMLElement).dataset.value || "";
        goToStep(4, "forward");
        startBudgetPlaceholder();
        return;
      }

      if (currentStep === 4) {
        const budgetInput = document.getElementById("budget-input") as HTMLInputElement;
        formData.budget = budgetInput.value.trim() || "non specificato";
        if (typeTimeout) clearTimeout(typeTimeout);
        goToStep(5, "forward");
        return;
      }

      if (currentStep === 5) {
        submitForm();
      }
    });

    // Submit
    async function submitForm() {
      const cognomeInput = document.getElementById("cognome-input") as HTMLInputElement;
      const emailInput = document.getElementById("email-input") as HTMLInputElement;
      const telefonoInput = document.getElementById("telefono-input") as HTMLInputElement;
      const privacyCheck = document.getElementById("privacy-check") as HTMLInputElement;

      const cognome = cognomeInput.value.trim();
      const email = emailInput.value.trim();
      const telefono = telefonoInput.value.trim();

      if (!cognome) { shake(cognomeInput); return; }
      if (!email || !email.includes("@") || !email.includes(".")) { shake(emailInput); return; }
      if (!telefono) { shake(telefonoInput); return; }
      if (!privacyCheck.checked) { shake(privacyCheck.closest("label") as HTMLElement); return; }

      formData.cognome = cognome;
      formData.email = email;
      formData.telefono = telefono;

      setBtnText("Invio in corso...");
      btnArrow.classList.add("hidden");
      btnSpinner.classList.remove("hidden");
      (btnNext as HTMLButtonElement).disabled = true;

      try {
        await new Promise((r) => setTimeout(r, 1500));
        // TODO: await fetch('/api/lead', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(formData) });
        updateUserName();
        goToStep("success" as any, "forward");
      } catch {
        setBtnText("Invia la richiesta");
        btnArrow.classList.remove("hidden");
        btnSpinner.classList.add("hidden");
        (btnNext as HTMLButtonElement).disabled = false;
      }
    }

    function shake(el: HTMLElement | null) {
      if (!el) return;
      gsap.to(el, { x: -5, duration: 0.05, yoyo: true, repeat: 5, ease: "power2.inOut" });
      if (el.tagName === "INPUT") (el as HTMLElement).focus();
      else { const input = el.querySelector("input"); if (input) (input as HTMLElement).focus(); }
    }
  });
</script>

<style>
