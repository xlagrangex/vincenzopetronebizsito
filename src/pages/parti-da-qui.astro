---
import LayoutMinimal from "../layouts/LayoutMinimal.astro";
import PortfolioDrawerIsland from "../components/react/PortfolioDrawerIsland.tsx";
---

<LayoutMinimal title="Parti da qui - Vincenzo Petrone Biz" description="Raccontaci il tuo progetto per una proposta gratuita su misura">

  <div class="glow-circle"></div>
  <div class="glow-circle glow-circle--2"></div>
  <PortfolioDrawerIsland client:load />

  <!-- Top bar: solo logo -->
  <header class="top-bar fixed top-0 left-0 right-0 z-50 flex items-center px-5 md:px-8" style="height:60px;">
    <a href="/" class="flex-shrink-0" aria-label="Torna alla homepage">
      <img src="/images/Group-15.png" alt="Vincenzo Petrone Biz" class="w-20 opacity-70 hover:opacity-100 transition-opacity" />
    </a>
  </header>
  <div class="fixed top-0 right-5 md:right-8 z-50 flex items-center" style="height:60px;">
    <a href="/start-here" class="flex items-center gap-1.5 rounded-full border border-white/15 bg-white/[0.04] backdrop-blur-sm px-3 py-1.5 text-xs font-medium text-black/60 hover:text-black hover:border-white/25 hover:bg-white/[0.08] transition-all duration-300">EN</a>
  </div>

  <main class="form-page relative flex flex-col justify-center items-center min-h-screen pt-20 pb-10 md:pt-24 md:pb-12 px-5 md:px-8">
    <div class="w-full max-w-2xl mx-auto">

      <!-- Progress bar (hidden on step 1, shown from step 2) -->
      <div class="form-progress mb-5" style="display:none;">
        <div class="flex items-center justify-between mb-2">
          <span class="step-label text-[0.7rem] font-semibold text-black/50">Step <span class="step-num-display">1</span> di 5</span>
          <span class="step-motivation text-[0.7rem] font-medium text-black/40"></span>
        </div>
        <div class="relative h-[5px] w-full overflow-hidden rounded-full bg-black/10">
          <div class="progress-fill absolute inset-y-0 left-0 rounded-full bg-[linear-gradient(90deg,#1B4088,#A51B80_60%,#DA5713)]" style="width:20%; transition: width 0.6s cubic-bezier(0.16,1,0.3,1);"></div>
        </div>
      </div>

      <!-- ═══ STEPS ═══ -->
      <div class="steps-wrapper relative">

        <!-- STEP 1: Nome (clean, minimal, focused) -->
        <div class="step-content" data-step="1">
          <div class="text-center mb-8">
            <p class="text-base text-black/40 mb-4">2 minuti, zero impegno, 100% su misura per te.</p>
            <h1 class="!text-[clamp(1.8rem,5vw,2.8rem)] !leading-[125%] font-semibold tracking-[-0.03em] text-black">
              Ogni grande progetto inizia<br class="hidden sm:block" /> con una conversazione.
            </h1>
          </div>
          <h2 class="!text-[clamp(1.4rem,3.5vw,1.8rem)] !leading-[130%] font-medium tracking-[-0.02em] text-black/70 text-center mb-6">
            Iniziamo dalle presentazioni. Come ti chiami?
          </h2>
          <div class="max-w-sm mx-auto">
            <input type="text" id="nome-input" class="form-input text-center text-lg" placeholder="Il tuo nome" autocomplete="given-name" autofocus />
          </div>
        </div>

        <!-- GREETING (transient, shown between step 1 and 2) -->
        <div class="step-content greeting-screen" data-step="greeting" style="display:none;">
          <div class="greeting-stage text-center flex items-center justify-center" style="min-height:200px;">
            <div class="greeting-slide greeting-slide-1 opacity-0">
              <h2 class="!text-[clamp(1.8rem,5vw,2.8rem)] !leading-[115%] font-semibold tracking-[-0.04em] text-black">
                Ciao <span class="greeting-name"></span>, piacere nostro! <span class="inline-block" style="font-size:1.2em;">👋</span>
              </h2>
            </div>
            <div class="greeting-slide greeting-slide-2 opacity-0">
              <div class="max-w-2xl mx-auto text-center">
                <h2 class="greeting-2a !text-[clamp(1.6rem,4.5vw,2.4rem)] !leading-[115%] font-semibold tracking-[-0.04em] text-black">
                  Noi siamo <span class="gradient-text-animated font-bold">Vincenzo Petrone Biz</span>...
                </h2>
                <p class="greeting-2b !text-[clamp(1.6rem,4.5vw,2.4rem)] !leading-[125%] font-semibold tracking-[-0.04em] text-black mt-5 opacity-0">
                  ...e se hai un <span class="word-warm-gradient">sogno</span> per la tua attività, noi vogliamo aiutarti a realizzarlo.
                </p>
              </div>
            </div>
            <div class="greeting-slide greeting-slide-3 opacity-0">
              <h2 class="!text-[clamp(1.6rem,4.5vw,2.4rem)] !leading-[115%] font-semibold tracking-[-0.04em] text-black">
                Sei pronto?
              </h2>
            </div>
            <div class="greeting-slide greeting-slide-4 opacity-0">
              <h2 class="greeting-finale !text-[clamp(1.8rem,5vw,2.8rem)] !leading-[115%] font-semibold tracking-[-0.04em] text-black">
                Iniziamo, <span class="greeting-name"></span>.
              </h2>
            </div>
          </div>
        </div>

        <!-- STEP 2: Cosa stai immaginando + Hai già un sito -->
        <div class="step-content" data-step="2" style="display:none;">
          <h2 class="!text-[clamp(1.7rem,4.5vw,2.4rem)] !leading-[120%] font-semibold tracking-[-0.03em] text-black text-center mb-6">
            <span class="user-name"></span>, raccontaci:<br />cosa stai immaginando?
          </h2>
          <div class="options-grid grid grid-cols-1 sm:grid-cols-2 gap-3" role="radiogroup" aria-label="Tipo di progetto">
            <button class="option-card" data-value="vetrina" role="radio" aria-checked="false" tabindex="0">
              <div class="option-icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 18-5v12L3 13v-2z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg></div>
              <span class="option-title">Un sito che parla per me</span>
              <span class="option-desc">Vetrina aziendale / professionale</span>
            </button>
            <button class="option-card" data-value="ecommerce" role="radio" aria-checked="false" tabindex="-1">
              <div class="option-icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></div>
              <span class="option-title">Un negozio che vende anche mentre dormo</span>
              <span class="option-desc">eCommerce</span>
            </button>
            <button class="option-card" data-value="landing" role="radio" aria-checked="false" tabindex="-1">
              <div class="option-icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 9 5 12 1.8-5.2L21 14Z"/><path d="M7.2 2.2 8 5.1"/><path d="m5.1 8-2.9-.8"/><path d="M14 4.1 12 6"/><path d="m6 12-1.9 2"/></svg></div>
              <span class="option-title">Una pagina che convince al primo scroll</span>
              <span class="option-desc">Landing page</span>
            </button>
            <button class="option-card" data-value="custom" role="radio" aria-checked="false" tabindex="-1">
              <div class="option-icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg></div>
              <span class="option-title">Qualcosa che ancora non esiste</span>
              <span class="option-desc">Progetto custom</span>
            </button>
          </div>

          <!-- Follow-up: Hai già un sito? (appare dopo selezione) -->
          <div class="followup mt-6" style="display:none;">
            <p class="text-sm text-black/60 text-center mb-3"><span class="user-name"></span>, parti da zero o hai già qualcosa online?</p>
            <div class="flex flex-wrap justify-center gap-2">
              <button class="chip" data-sito="zero">Parto da zero</button>
              <button class="chip" data-sito="rifare">Ho un sito ma è ora di cambiare</button>
              <button class="chip" data-sito="migliorare">Ho un sito e voglio potenziarlo</button>
            </div>
            <!-- Campo link condizionale -->
            <div class="link-field mt-4" style="display:none;">
              <label class="text-xs text-black/50 mb-1.5 block">Inserisci il link del tuo sito attuale</label>
              <div class="flex items-center gap-0 rounded-[0.875rem] border border-white/15 bg-white/[0.05] overflow-hidden">
                <span class="pl-3 pr-1 text-sm text-black/30 select-none flex-shrink-0">https://</span>
                <input type="text" id="sito-attuale" class="flex-1 py-3 pr-3 bg-transparent text-black text-sm outline-none placeholder:text-black/25" placeholder="www.iltuosito.it" />
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 3: La tua azienda -->
        <div class="step-content" data-step="3" style="display:none;">
          <h2 class="!text-[clamp(1.7rem,4.5vw,2.4rem)] !leading-[120%] font-semibold tracking-[-0.03em] text-black text-center mb-6">
            <span class="user-name"></span>, parlaci della tua attività.
          </h2>
          <div class="max-w-md mx-auto flex flex-col gap-4 mb-6">
            <input type="text" id="azienda-input" class="form-input" placeholder="Nome dell'azienda o del progetto" />
            <input type="text" id="settore-input" class="form-input" placeholder="In che settore lavori? (es. ristorazione, moda, tech...)" />
          </div>
          <p class="text-sm text-black/50 text-center mb-3">A che punto è la tua attività?</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-lg mx-auto" role="radiogroup" aria-label="Maturità azienda">
            <button class="option-card option-card-compact" data-value="brand-nuovo" role="radio" aria-checked="false" tabindex="0">
              <span class="option-title">Un brand che deve ancora nascere</span>
              <span class="option-desc">Idea o progetto da costruire</span>
            </button>
            <button class="option-card option-card-compact" data-value="attivita-partenza" role="radio" aria-checked="false" tabindex="-1">
              <span class="option-title">Un'attività in partenza</span>
              <span class="option-desc">Primi passi, tutto da impostare</span>
            </button>
            <button class="option-card option-card-compact" data-value="attivita-esistente" role="radio" aria-checked="false" tabindex="-1">
              <span class="option-title">Un'attività già esistente</span>
              <span class="option-desc">Operativa, vuole crescere online</span>
            </button>
            <button class="option-card option-card-compact" data-value="attivita-consolidata" role="radio" aria-checked="false" tabindex="-1">
              <span class="option-title">Un'attività consolidata</span>
              <span class="option-desc">Volumi importanti, vuole il salto</span>
            </button>
          </div>
        </div>

        <!-- STEP 4: Budget -->
        <div class="step-content" data-step="4" style="display:none;">
          <h2 class="!text-[clamp(1.7rem,4.5vw,2.4rem)] !leading-[120%] font-semibold tracking-[-0.03em] text-black text-center mb-3">
            <span class="user-name"></span>, ora la domanda che tutti odiano.
          </h2>
          <p class="text-sm text-black/40 text-center mb-2 max-w-md mx-auto leading-relaxed">
            Ma te la facciamo lo stesso perché ci piace essere diretti.
          </p>
          <p class="text-xs text-black/30 text-center mb-5 max-w-md mx-auto leading-relaxed">
            Un'idea di budget ci aiuta a non farti perdere tempo con proposte fuori target. Non è un contratto — è un punto di partenza.
          </p>

          <!-- Toggle espandibile (senza box) -->
          <div class="max-w-md mx-auto mb-6 text-center">
            <button class="budget-toggle inline-flex items-center gap-1.5 cursor-pointer transition-colors duration-300 bg-transparent border-none outline-none" type="button">
              <span class="text-xs text-black/40 underline underline-offset-2 decoration-white/20 hover:decoration-white/40">Perché ti chiediamo il budget?</span>
              <svg class="budget-toggle-arrow w-3.5 h-3.5 text-black/30 transition-transform duration-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="budget-toggle-content overflow-hidden" style="max-height:0; opacity:0; transition: max-height 0.5s ease, opacity 0.4s ease;">
              <div class="pt-4 pb-1 text-xs text-black/35 leading-[175%] space-y-3 max-w-sm mx-auto text-left">
                <p>Lo sappiamo, parlare di soldi non è mai semplice. Ma crediamo che la trasparenza sia la base di ogni buon rapporto di lavoro.</p>
                <p>Il motivo principale è semplice: <strong class="text-black/50">evitare di perdere tempo — sia il tuo che il nostro.</strong> Senza un'indicazione di budget, rischiamo di fare due o tre call conoscitive, preparare una proposta dettagliata, e poi scoprire che non siamo allineati sulle cifre. È frustrante per entrambi.</p>
                <p>Con un'idea di budget, anche molto approssimativa, possiamo subito capire quale soluzione proporti e come strutturare l'offerta in modo che abbia senso per te.</p>
                <p>E tranquillo: <strong class="text-black/50">il budget non è una cifra scolpita nella pietra.</strong> Tanti dei nostri clienti cambiano idea dopo aver visto cosa possiamo offrire — a volte investono di più perché vedono il valore, a volte troviamo soluzioni più snelle che costano meno. È un punto di partenza, non un vincolo.</p>
              </div>
            </div>
          </div>

          <div class="max-w-sm mx-auto">
            <input type="text" id="budget-input" class="form-input text-center text-lg" placeholder="" />
            <p class="text-[0.65rem] text-black/25 text-center mt-2">Questo numero resta tra noi.</p>
          </div>
        </div>

        <!-- STEP 5: Contatti finali -->
        <div class="step-content" data-step="5" style="display:none;">
          <h2 class="!text-[clamp(1.7rem,4.5vw,2.4rem)] !leading-[120%] font-semibold tracking-[-0.03em] text-black text-center mb-3">
            Ci siamo, <span class="user-name"></span> — e poi ci mettiamo al lavoro per te.
          </h2>
          <p class="text-sm text-black/40 text-center mb-6">Lasciaci i tuoi contatti per ricontattarti.</p>
          <div class="max-w-sm mx-auto flex flex-col gap-3">
            <input type="text" id="cognome-input" class="form-input" placeholder="Cognome *" autocomplete="family-name" />
            <input type="email" id="email-input" class="form-input" placeholder="Email *" autocomplete="email" />
            <input type="tel" id="telefono-input" class="form-input" placeholder="Telefono *" autocomplete="tel" />
            <label class="flex items-start gap-3 cursor-pointer group mt-1">
              <div class="relative mt-0.5 flex-shrink-0">
                <input type="checkbox" id="privacy-check" class="peer sr-only" />
                <div class="h-5 w-5 rounded-md border border-black/20 bg-white/[0.04] transition-all duration-200 peer-checked:border-[#A51B80]/50 peer-checked:bg-[#A51B80]/15 group-hover:border-black/30"></div>
                <svg class="absolute top-0.5 left-0.5 h-4 w-4 text-black opacity-0 transition-opacity duration-200 peer-checked:opacity-100 pointer-events-none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <span class="text-xs text-black/50 leading-relaxed">Acconsento al trattamento dei dati ai sensi del <a href="/legal/privacy-policy" class="underline underline-offset-2 text-black/60 hover:text-black/80 transition-colors">GDPR</a></span>
            </label>
          </div>
          <p class="text-xs text-black/25 text-center mt-5">Ti rispondiamo entro 24 ore — e se non lo facciamo, il caffè lo offriamo noi.</p>
        </div>

        <!-- SUCCESS -->
        <div class="step-content" data-step="success" style="display:none;">
          <div class="flex flex-col items-center text-center py-8">
            <div class="success-icon relative mb-6">
              <div class="absolute inset-0 rounded-full bg-[linear-gradient(135deg,#1B4088,#A51B80_50%,#DA5713)] opacity-25 blur-2xl scale-[2]"></div>
              <div class="relative flex h-20 w-20 items-center justify-center rounded-full bg-[linear-gradient(135deg,#1B4088,#A51B80_50%,#DA5713)]">
                <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
            </div>
            <h2 class="success-title !text-[clamp(1.8rem,5vw,2.8rem)] !leading-[110%] font-semibold tracking-[-0.04em] text-black mb-3">
              <span class="user-name"></span>, la tua richiesta è nelle mani giuste.
            </h2>
            <p class="success-desc text-sm text-black/50 max-w-sm leading-relaxed mb-2">Ti scriviamo a <span class="user-email font-medium text-black/70"></span> entro 24 ore.</p>
            <p class="text-sm text-black/40 mb-8">Nel frattempo, guarda cosa abbiamo fatto per chi — come te — si è fidato di noi.</p>
            <div class="flex flex-col sm:flex-row items-center gap-4">
              <a href="https://calendly.com/bizstudio-it/30min" target="_blank" rel="noopener noreferrer" class="btn-gradient group relative inline-block rounded-full font-semibold text-black shadow-[0_8px_20px_rgba(0,0,0,0.3)] transition-all duration-300 hover:shadow-[0_12px_30px_rgba(165,27,128,0.3)] bg-[linear-gradient(135deg,#1B4088,#A51B80_50%,#DA5713)] saturate-[1.15]"><div class="relative overflow-hidden rounded-full px-7 py-3 shadow-[inset_0_0_7px_rgba(255,255,255,0.28)] group-hover:shadow-[inset_0_0_14px_rgba(255,255,255,0.5)]"><span class="relative z-[5] block text-sm font-semibold tracking-[-0.02em]">Prenota una chiamata</span></div></a>
              <button class="open-portfolio-bottom text-sm font-medium text-black/40 hover:text-black/70 transition-colors underline underline-offset-4 decoration-white/20 hover:decoration-white/40 cursor-pointer bg-transparent border-none">Vedi i nostri lavori</button>
            </div>
          </div>
        </div>

      </div>

      <!-- Navigation -->
      <div class="form-nav flex items-center justify-between mt-8 max-w-sm mx-auto">
        <button class="btn-back group flex items-center gap-2 text-sm font-medium text-black/40 hover:text-black/70 transition-all duration-300 cursor-pointer invisible">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:-translate-x-1"><path d="m15 18-6-6 6-6"/></svg>
          <span>Indietro</span>
        </button>
        <button class="btn-next btn-gradient group relative inline-block rounded-full text-center font-medium shadow-[0_16px_20px_rgba(0,0,0,0.4)] transition-all duration-300 ease-out hover:shadow-[0_20px_40px_rgba(165,27,128,0.3)] active:shadow-[0_4px_4px_rgba(0,0,0,0.3)] cursor-pointer bg-[linear-gradient(135deg,#1B4088,#A51B80_50%,#DA5713)] saturate-[1.15]">
          <div class="relative z-10 overflow-hidden rounded-full px-5 py-2.5 shadow-[inset_0_0_7px_rgba(255,255,255,0.28)] transition-shadow duration-300 group-hover:shadow-[inset_0_0_14px_rgba(255,255,255,0.5)]">
            <div class="pointer-events-none absolute inset-0 z-[1] rounded-full"><div class="expand-ball expand-ball-1"></div><div class="expand-ball expand-ball-2"></div></div>
            <span class="relative z-[5] block overflow-hidden text-sm font-semibold tracking-[-0.03em] text-black">
              <span class="btn-text-wrap flex items-center gap-2 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-translate-y-full"><span class="btn-text">Continua</span><svg class="btn-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg><svg class="btn-spinner hidden animate-spin" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/></svg></span>
              <span class="btn-text-clone absolute inset-0 flex items-center justify-center gap-2 translate-y-full transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-y-0"><span>Continua</span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
            </span>
          </div>
          <div class="btn-glow pointer-events-none absolute inset-0 z-0 rounded-full blur-md transition-opacity duration-300 opacity-30 group-hover:opacity-50"><div class="expand-ball expand-ball-1"></div><div class="expand-ball expand-ball-2"></div></div>
        </button>
      </div>

      <!-- Social proof + Vedi lavori -->
      <div class="social-proof mt-8 flex flex-col items-center gap-3">
        <div class="flex items-center justify-center gap-3">
          <div class="flex items-baseline gap-1.5">
            <span class="text-xl font-bold tracking-[-0.03em] gradient-text-animated">+50</span>
            <span class="text-xs text-black/45">aziende ci hanno scelto</span>
          </div>
          <div class="flex items-center gap-1">
            <span class="text-amber-400 text-xs">★★★★★</span>
            <span class="text-[0.65rem] text-black/45 font-semibold">4.9/5</span>
          </div>
        </div>
        <button class="open-portfolio-bottom group relative inline-block rounded-full text-center font-medium cursor-pointer border border-white/15 bg-white/[0.04] backdrop-blur-sm transition-all duration-300 hover:border-white/25 hover:bg-white/[0.08] hover:shadow-[0_0_20px_rgba(255,255,255,0.06)]">
          <div class="relative overflow-hidden rounded-full px-5 py-2">
            <span class="relative block overflow-hidden text-xs font-semibold tracking-[-0.02em] text-black/60 group-hover:text-black transition-colors duration-300">
              <span class="flex items-center gap-1.5 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-translate-y-full">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
                Vedi i nostri lavori
              </span>
              <span class="absolute inset-0 flex items-center justify-center gap-1.5 translate-y-full transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-y-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
                Vedi i nostri lavori
              </span>
            </span>
